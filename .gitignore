# ---------------------------------------------------------------- Gradle / Android
.gradle/
build/
local.properties
*.iml
.idea/
captures/
.externalNativeBuild/
.cxx/

# ---------------------------------------------------------------- 签名材料：绝不入版本库
# 泄露 jks 与密码 = 把发布权交出去，且已安装设备无法安全升级
keystore.properties
release/
*.jks
*.keystore

# ---------------------------------------------------------------- 构建 / 分发产物
# dist/ 里的 APK 只做本机归档，对外分发走 GitHub Release
dist/
*.apk
*.apk.sha256

# ---------------------------------------------------------------- 词库构建缓存
# 原始数据源约 8MB，可由 scripts/build-dict.py 重新拉取
scripts/.cache/

# ---------------------------------------------------------------- 本地临时文件
.tmp_*
*.log
apk-cache/

# ---------------------------------------------------------------- 工具内部数据
.workbuddy/

# ---------------------------------------------------------------- 系统
.DS_Store
Thumbs.db
desktop.ini
