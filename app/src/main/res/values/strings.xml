    <string name="settings_status_disabled">未启用（系统还不知道有这个键盘）</string>
    <string name="settings_status_enabled">已启用，但还不是当前输入法</string>
    <string name="settings_status_current">已启用并选中，可直接使用</string>
    <string name="settings_test">在此处试打：</string>
