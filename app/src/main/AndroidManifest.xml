<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />

    <!--
      仅用于「一键启用并选中输入法」：直接写 Settings.Secure 的 ENABLED_INPUT_METHODS /
      DEFAULT_INPUT_METHOD。该权限是 signature|privileged|development 级，安装时不会授予，
      必须由使用者主动执行一次：
          adb shell pm grant com.tvboard.ime android.permission.WRITE_SECURE_SETTINGS
      未授权时设置页不显示该按钮，走原本的手工引导路径，不影响功能。
    -->
    <uses-permission
        android:name="android.permission.WRITE_SECURE_SETTINGS"
        tools:ignore="ProtectedPermissions" />

    <!-- 电视设备无触摸屏；本应用非 Leanback 专属，手机/平板亦可安装 -->
    <uses-feature
        android:name="android.hardware.touchscreen"
        android:required="false" />
    <uses-feature
        android:name="android.software.leanback"
        android:required="false" />

    <!-- API 30+ 包可见性：打开接收到的文件需要能查询到处理该 MIME 的应用 -->
    <queries>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:mimeType="*/*" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="content" />
        </intent>
    </queries>

    <application
        android:allowBackup="true"
        android:banner="@drawable/banner"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="false"
        android:theme="@style/Theme.TvBoard">

        <!-- 输入法服务：系统通过 BIND_INPUT_METHOD 绑定，exported 在 API 31+ 为强制 -->
        <service
            android:name=".ime.TvImeService"
            android:exported="true"
            android:label="@string/ime_name"
            android:permission="android.permission.BIND_INPUT_METHOD">
            <intent-filter>
                <action android:name="android.view.InputMethod" />
            </intent-filter>
            <meta-data
                android:name="android.view.im"
                android:resource="@xml/method" />
        </service>

        <!-- 入口：既是设置页也是电视桌面图标 -->
        <activity
            android:name=".ui.SettingsActivity"
            android:exported="true"
            android:launchMode="singleTop">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>
